# Vercel function configuration. Set secrets in the project's environment settings.
REVTURBINE_TENANT_ID=tn_example
REVTURBINE_API_KEY=replace_with_a_secret_server_token
REVTURBINE_ENDPOINT=https://revturbine.com/app
# Exact trusted origins returned by your deployment's authenticated bootstrap.
# Include the control-plane origin if it serves relative manifest/bundle paths.
REVTURBINE_CDN_ORIGINS=https://revturbine.com,https://replace-with-your-delivery-origin.example

# Application-issued context token verification (public configuration).
CONTEXT_JWKS_URL=https://auth.example.com/.well-known/jwks.json
CONTEXT_ISSUER=https://auth.example.com
CONTEXT_AUDIENCE=https://api.example.com/edge-entitlements

# The token issuer's private key belongs ONLY on the trusted issuer backend.
# This Edge Function does not need that private key.
