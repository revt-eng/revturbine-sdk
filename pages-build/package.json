{
  "name": "revturbine-sdk-pages-build",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-deps.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/check-deps.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "lint:md": "markdownlint-cli2 \"src/content/docs/{getting-started,tutorials,guides,concepts,reference,playground}/**/*.{md,mdx}\"",
    "lint:links": "node scripts/check-links.mjs",
    "lint:snippets": "node scripts/check-snippets.mjs",
    "lint:config": "node scripts/check-config-examples.mjs",
    "lint:reason-codes": "node scripts/check-reason-codes.mjs",
    "gen:reason-codes": "node scripts/gen-reason-codes.mjs",
    "lint:no-internal-pkg": "node scripts/check-no-internal-pkg.mjs",
    "check": "pnpm lint:no-internal-pkg && pnpm typecheck && pnpm test && pnpm lint:md && pnpm lint:config && pnpm lint:reason-codes && pnpm build && pnpm lint:links",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint:deps": "node scripts/check-deps.mjs",
    "test": "vitest --run"
  },
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "@astrojs/starlight": "^0.38.4",
    "@codesandbox/sandpack-react": "^2.20.0",
    "@revt-eng/core": "0.1.409",
    "@revt-eng/schema": "0.1.409",
    "@revt-eng/schema-external": "0.1.409",
    "@revturbine/sdk": "0.11.16",
    "astro": "^6.1.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "remark-gfm": "^4.0.0",
    "starlight-llms-txt": "^0.10.0",
    "starlight-typedoc": "^0.21.5",
    "typedoc-plugin-markdown": "^4.11.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.27.7",
    "markdownlint-cli2": "^0.22.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  }
}
