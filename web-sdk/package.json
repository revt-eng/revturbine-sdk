{
  "name": "@revt-eng/sdk",
  "version": "0.12.2",
  "description": "RevTurbine customer-facing SDK — placement decisioning, entitlement checks, and usage tracking.",
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "headless": [
        "./dist/headless.d.ts"
      ],
      "growthbook": [
        "./dist/growthbook.d.ts"
      ],
      "optimizely": [
        "./dist/optimizely.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    },
    "./headless": {
      "import": {
        "types": "./dist/headless.d.ts",
        "default": "./dist/headless.js"
      },
      "require": {
        "types": "./dist/headless.d.cts",
        "default": "./dist/headless.js"
      },
      "default": "./dist/headless.js"
    },
    "./growthbook": {
      "import": {
        "types": "./dist/growthbook.d.ts",
        "default": "./dist/growthbook.js"
      },
      "require": {
        "types": "./dist/growthbook.d.cts",
        "default": "./dist/growthbook.js"
      },
      "default": "./dist/growthbook.js"
    },
    "./optimizely": {
      "import": {
        "types": "./dist/optimizely.d.ts",
        "default": "./dist/optimizely.js"
      },
      "require": {
        "types": "./dist/optimizely.d.cts",
        "default": "./dist/optimizely.js"
      },
      "default": "./dist/optimizely.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/*.js",
    "dist/*.js.map",
    "dist/*.d.ts",
    "dist/*.d.cts",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json --emitDeclarationOnly --declaration --declarationDir dist/types && rollup -c rollup.dts.config.mjs && node scripts/strip-internal-refs.mjs dist",
    "verify": "cd ../revturbine-web && npm run typecheck",
    "typecheck:sdk-api": "pnpm exec tsx ../scripts/check-sdk-types.ts",
    "playground": "vite --config playground/vite.config.ts",
    "harness:headless": "pnpm exec tsx ../scripts/headless-harness.ts",
    "check:public-types": "node scripts/check-public-types.mjs",
    "check:headless-standalone": "node scripts/check-headless-standalone.mjs",
    "check:public-diagnostics": "node scripts/check-public-diagnostics.mjs",
    "check:packed-consumer": "node scripts/check-packed-consumer.mjs"
  },
  "peerDependencies": {
    "@growthbook/growthbook": ">=1.0.0",
    "@optimizely/optimizely-sdk": ">=6.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@growthbook/growthbook": {
      "optional": true
    },
    "@optimizely/optimizely-sdk": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@growthbook/growthbook": "^1.7.0",
    "@optimizely/optimizely-sdk": "^6.5.0",
    "@revt-eng/core": "0.1.507",
    "@revt-eng/schema": "0.1.507",
    "@revt-eng/schema-external": "0.1.507",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "openapi-fetch": "^0.17.0",
    "playwright": "^1.61.1",
    "rollup": "^4.62.4",
    "rollup-plugin-dts": "^6.5.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revt-eng/revturbine-sdk-internal.git",
    "directory": "web-sdk"
  },
  "license": "MIT",
  "dependencies": {
    "zod": "4.4.3"
  }
}
